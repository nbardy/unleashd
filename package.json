{
  "name": "unleashd",
  "version": "1.1.0",
  "private": false,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepack": "pnpm build",
    "dev": "node tools/dev-supervisor.mjs",
    "dev:replace": "node tools/dev-supervisor.mjs --replace",
    "dev:server": "node tools/dev-supervisor.mjs --task dev-server",
    "dev:client": "node tools/dev-supervisor.mjs --task dev-client",
    "local-domain:setup": "sudo bash tools/setup-domain.sh install",
    "local-domain:remove": "sudo bash tools/setup-domain.sh remove",
    "build": "node tools/dev-supervisor.mjs --task build",
    "start": "node server/dist/server.js",
    "typecheck": "node tools/dev-supervisor.mjs --task typecheck",
    "test": "pnpm typecheck && pnpm build && pnpm test:server && pnpm test:client && pnpm test:dev-supervisor && pnpm test:cli && pnpm test:package && pnpm test:api",
    "test:server": "pnpm exec tsx --test server/test/*.test.ts",
    "test:client": "pnpm exec tsx --test client/test/*.test.ts",
    "screenshot:mobile": "node tools/screenshot-mobile.mjs",
    "test:dev-supervisor": "node --test tools/dev-supervisor.test.mjs tools/local-domain.test.mjs tools/watch-runtime-readiness.test.mjs tools/watch-server.test.mjs tools/watch-snapshot.test.mjs",
    "test:live:tools": "UNLEASHD_LIVE_TOOL_INTEGRATION=1 pnpm exec tsx --test server/test/tool-integration.test.ts",
    "test:cli": "pnpm --dir vendor/agent-cli-tool test",
    "test:package": "node test/package-smoke.js",
    "test:api": "node test/api.test.js",
    "vendor:buddies": "node tools/vendor-buddies.mjs",
    "sub:latest": "git submodule update --remote --merge vendor/agent-cli-tool && git -C vendor/agent-cli-tool log --oneline -1",
    "check:catalog": "pnpm --filter @unleashd/shared check:catalog",
    "check:client-invariants": "bash tools/check-client-invariants.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.1.2",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.7.0",
    "ws": "^8.14.2"
  },
  "bin": {
    "unleashd": "./bin/unleashd.js"
  },
  "files": [
    "bin",
    "server/dist",
    "client/dist"
  ],
  "bundledDependencies": [
    "@nbardy/agent-cli",
    "@nbardy/buddies",
    "@unleashd/shared"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nbardy/agent-cli": "workspace:0.1.1",
    "@nbardy/buddies": "file:vendor/nbardy-buddies-0.1.0.tgz",
    "@unleashd/shared": "workspace:1.0.0",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "uuid": "^13.0.0",
    "ws": "^8.14.2",
    "zod": "^3.24.0"
  }
}
